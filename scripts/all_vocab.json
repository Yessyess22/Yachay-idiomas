  "storyTurns": [
    {
      "speaker": "yachi",
      "quechua": "Huk, iskay, kimsa!",
      "spanish": "¡Uno, dos, tres!"
    },
    {
      "speaker": "yachi",
      "quechua": "Tawa, pichqa!",
      "spanish": "¡Cuatro, cinco!"
    },
    {
      "speaker": "yachi",
      "quechua": "Allinmi!",
      "spanish": "¡Muy bien!"
    },
    {
      "speaker": "yachi",
      "quechua": "Wasi!",
      "spanish": "¡Casa!"
    },
    {
      "speaker": "yachi",
      "quechua": "Mishki!",
      "spanish": "¡Dulce!"
    },
    {
      "speaker": "yachi",
      "quechua": "Allinmi!",
      "spanish": "¡Muy bien!"
    },
    {
      "speaker": "yachi",
      "quechua": "Allillanchu?",
      "spanish": "¿Cómo estás?"
    },
    {
      "speaker": "yachi",
      "quechua": "Yupaychani!",
      "spanish": "¡Gracias!"
    },
    {
      "speaker": "yachi",
      "quechua": "Tupananchiskama!",
      "spanish": "¡Hasta que nos volvamos a ver!"
    },
    {
      "speaker": "yachi",
      "quechua": "Atoqqa Kunturwan hanan pachaman rirqan.",
      "spanish": "El zorro fue con el cóndor al mundo celestial."
    },
    {
      "speaker": "yachi",
      "quechua": "Hanan pachapi mikhuymanta sarata mikhurqan!",
      "spanish": "¡En las alturas comió el maíz sagrado!"
    },
    {
      "speaker": "yachi",
      "quechua": "Chayrayku kay allpaman mikhuykuna chayamurqan!",
      "spanish": "¡Por eso las semillas llegaron a la tierra!"
    },
    {
      "speaker": "yachi",
      "quechua": "Allillamanta yachanchis! Añay!",
      "spanish": "¡Poco a poco aprendemos! ¡Gracias!"
    },
    {
      "speaker": "yachi",
      "quechua": "Inti taytanchismi runakunata yanapanapaq kachamurqan.",
      "spanish": "El padre Sol los envió para ayudar y enseñar al pueblo."
    },
    {
      "speaker": "yachi",
      "quechua": "Titiqaqa quchamanta lluqsimurqanku.",
      "spanish": "Emergieron del sagrado lago Titicaca."
    },
    {
      "speaker": "yachi",
      "quechua": "Chaypi hatun Tawantinsuyu paqarirqan!",
      "spanish": "¡Allí nació el gran Tawantinsuyu!"
    },
    {
      "speaker": "yachi",
      "quechua": "Sumaq Kawsayqa Pachamamawan allin kawsaymi.",
      "spanish": "El Buen Vivir es convivir en armonía con la Madre Tierra."
    },
    {
      "speaker": "yachi",
      "quechua": "Ayni: Paqarin qanpaq, mincha ñuqaqpaw.",
      "spanish": "Ayni: Hoy por ti, mañana por mí."
    },
    {
      "speaker": "yachi",
      "quechua": "Ama suwa, ama llulla, ama qilla: allin runa kay!",
      "spanish": "¡No seas ladrón, ni mentiroso, ni ocioso: sé una persona honorable!"
    },
    {
      "speaker": "yachi",
      "quechua": "Kawsachun Runasimi! Tupananchiskama!",
      "spanish": "¡Que viva el Quechua! ¡Hasta volver a vernos!"
    }
  ]
}