# ─── Supabase ────────────────────────────────────────────────
# Obtenlo en: https://supabase.com → tu proyecto → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ─── Firebase ────────────────────────────────────────────────
# Obtenlo en: https://console.firebase.google.com → tu proyecto → Configuración → General
EXPO_PUBLIC_FIREBASE_API_KEY=tu_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=tu_app_id

# ─── Voz Quechua con IA: TTS + STT (OPCIONAL) ────────────────
# Sin esto la app igual funciona: el audio usará la síntesis nativa del
# dispositivo/navegador, y el micrófono en Quechua no estará disponible.
# Con esto activado, la app usa modelos entrenados específicamente en
# Quechua para generar audio auténtico (TTS) y transcribir lo que el
# estudiante dice (STT), ver carpeta /voice-service.
#
# Desarrollo local:
#   1. cd voice-service && pip install -r requirements.txt
#   2. python app.py   (descarga ~2.7 GB de modelos la primera vez)
#   3. El servidor corre en http://localhost:8000 — revisa /health
#   4. Deja esta variable vacía o coméntala: usará localhost:8000 por defecto
#
# Producción / APK (necesario para que el micrófono y el audio funcionen
# fuera de tu máquina): despliega /voice-service en Modal (gratis, ver
# voice-service/README.md) y pon aquí la URL pública que te da:
# EXPO_PUBLIC_VOICE_SERVICE_URL=https://TU_USUARIO--yachay-voice-service-voiceservice-web.modal.run
