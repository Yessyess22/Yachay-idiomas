# ─── Supabase ────────────────────────────────────────────────
# Obtenlo en: https://supabase.com → tu proyecto → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ─── Firebase ────────────────────────────────────────────────
# Obtenlo en: https://console.firebase.google.com → tu proyecto → Configuración → General
EXPO_PUBLIC_FIREBASE_API_KEY=tu_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=tu_app_id

# ─── Audio Quechua auténtico con IA (OPCIONAL) ───────────────
# Sin esto la app igual funciona, pero el audio de pronunciación
# usará la síntesis de voz nativa del navegador en vez del modelo
# de Meta MMS-TTS entrenado específicamente en Quechua.
#
# Para activarlo:
#   1. Instalar dependencias Python:
#      pip install fastapi uvicorn transformers torch soundfile numpy
#
#   2. Iniciar el servidor local (descarga el modelo ~1.5 GB la primera vez):
#      python tts_service.py
#
#   El servidor corre en http://localhost:8000
#   Puedes verificar que funciona entrando a http://localhost:8000/health
